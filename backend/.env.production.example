# Enables rate limiting on /quotes (30 req/min per IP), CORS enforcement
# against CORS_ORIGIN, and hides verbose error bodies from responses.

NODE_ENV=production

# PORT=8080

CORS_ORIGIN=https://bridgekitty.persistence.one,https://bridgekittydemo.vercel.app
PERSISTENCE_API_BASE_URL=https://api.bridgekitty.persistence.one/api/v1